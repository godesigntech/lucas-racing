# Copy to .env.local and fill in.

# Supabase project (public values, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Used by `npm run db:migrate`. Supabase > Connect > Session pooler URI.
SUPABASE_DB_URL=

# true = run the UI on built-in sample data with Supabase switched off (nothing is saved).
DEMO_MODE=false

# Address used in email links. Defaults to https://lucasracing.co.uk.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (optional). Order confirmations and workshop alerts are sent through Resend
# once both are set; without them the site works and simply skips email.
# EMAIL_FROM must use a domain verified in Resend, e.g. "Lucas Racing <orders@lucasracing.co.uk>".
RESEND_API_KEY=
EMAIL_FROM=
# Workshop alerts go to the contact email in admin Settings; this is only a fallback.
WORKSHOP_EMAIL=

# AI design assistant (optional). Without them the assistant
# still suggests designs with its built-in colour matcher.
# Google Gemini writes the concept and picks the closest templates.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# AI images each visitor may make per hour (1-100). Defaults to 5; raise it while testing.
# AI_IMAGES_PER_HOUR=5
# OpenAI paints the concept image when its key is set (edits the customer's photo;
# a few cents an image, from the OpenAI account's credit).
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# OPENAI_IMAGE_QUALITY=medium
# Otherwise Cloudflare Workers AI paints it (free up to a daily allowance:
# about 14 designs a day from a customer photo, far more from a description).
# Account ID is on the dashboard home page; make the token from the "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
